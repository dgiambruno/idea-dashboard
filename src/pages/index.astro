---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Idea Bank">
  <main class="max-w-5xl mx-auto p-8">
    <div class="flex justify-between items-end mb-8">
      <div>
        <h1 class="text-4xl font-bold">Idea Bank</h1>
        <p class="text-gray-600 mt-1">Track, classify, and connect your ideas.</p>
      </div>
      <div class="text-sm text-gray-500">
        Powered by Cloudflare D1
      </div>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap gap-3 mb-6">
      <input 
        type="text" 
        id="search" 
        placeholder="Search ideas..." 
        class="flex-1 min-w-[200px] border rounded-lg px-4 py-2 text-sm"
      />
      
      <select id="classification-filter" class="border rounded-lg px-4 py-2 text-sm">
        <option value="">All Classifications</option>
        <option value="Business">Business</option>
        <option value="AI">AI</option>
        <option value="Personal">Personal</option>
        <option value="Product">Product</option>
        <option value="Design">Design</option>
        <option value="Research">Research</option>
        <option value="Marketing">Marketing</option>
        <option value="Technical">Technical</option>
        <option value="Other">Other</option>
      </select>

      <select id="status-filter" class="border rounded-lg px-4 py-2 text-sm">
        <option value="">All Statuses</option>
        <option value="idea">Idea</option>
        <option value="in-progress">In Progress</option>
        <option value="done">Done</option>
        <option value="archived">Archived</option>
      </select>
    </div>

    <!-- Add Idea Form -->
    <div class="bg-white rounded-2xl shadow-sm border p-6 mb-10">
      <h2 class="text-xl font-semibold mb-4">Add New Idea</h2>
      <form id="add-idea-form" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Title *</label>
            <input type="text" name="title" required class="w-full border rounded-lg px-4 py-2" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Classification</label>
            <select name="classification" class="w-full border rounded-lg px-4 py-2">
              <option value="">Select classification</option>
              <option value="Business">Business</option>
              <option value="AI">AI</option>
              <option value="Personal">Personal</option>
              <option value="Product">Product</option>
              <option value="Design">Design</option>
              <option value="Research">Research</option>
              <option value="Marketing">Marketing</option>
              <option value="Technical">Technical</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Description</label>
          <textarea name="content" rows="3" class="w-full border rounded-lg px-4 py-2"></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Category</label>
            <input type="text" name="category" class="w-full border rounded-lg px-4 py-2" placeholder="branding, infrastructure..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Status</label>
            <select name="status" class="w-full border rounded-lg px-4 py-2">
              <option value="idea">Idea</option>
              <option value="in-progress">In Progress</option>
              <option value="done">Done</option>
              <option value="archived">Archived</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Source</label>
            <input type="text" name="source" class="w-full border rounded-lg px-4 py-2" placeholder="Obsidian, meeting, etc." />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Code URL</label>
            <input type="url" name="code_url" class="w-full border rounded-lg px-4 py-2" placeholder="https://github.com/..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Source / Data / Files URL</label>
            <input type="url" name="source_url" class="w-full border rounded-lg px-4 py-2" placeholder="https://..." />
          </div>
        </div>

        <button type="submit" class="mt-2 bg-black text-white px-8 py-2.5 rounded-xl hover:bg-gray-900 transition">
          Save Idea
        </button>
      </form>
    </div>

    <!-- Ideas List -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold">Ideas</h2>
        <div id="results-count" class="text-sm text-gray-500"></div>
      </div>
      <div id="ideas-list" class="space-y-4"></div>
    </div>
  </main>

  <script>
    let debounceTimer;

    function debounce(fn, delay = 300) {
      return (...args) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => fn(...args), delay);
      };
    }

    async function loadIdeas() {
      const search = document.getElementById('search').value;
      const classification = document.getElementById('classification-filter').value;
      const status = document.getElementById('status-filter').value;

      const params = new URLSearchParams();
      if (search) params.set('search', search);
      if (classification) params.set('classification', classification);
      if (status) params.set('status', status);

      const res = await fetch(`/api/ideas?${params}`);
      const data = await res.json();
      renderIdeas(data.ideas || []);
    }

    function renderIdeas(ideas) {
      const container = document.getElementById('ideas-list');
      const countEl = document.getElementById('results-count');
      
      countEl.textContent = `${ideas.length} idea${ideas.length !== 1 ? 's' : ''}`;

      if (!ideas.length) {
        container.innerHTML = `<p class="text-gray-500 py-8">No ideas found.</p>`;
        return;
      }

      container.innerHTML = ideas.map(idea => `
        <div class="bg-white border rounded-2xl p-6 hover:shadow-sm transition">
          <div class="flex justify-between items-start gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-3 flex-wrap">
                <h3 class="font-semibold text-lg">${idea.title}</h3>
                ${idea.classification ? 
                  `<span class="text-xs px-3 py-0.5 rounded-full bg-zinc-100 text-zinc-700">${idea.classification}</span>` : ''}
                <span class="text-xs px-3 py-0.5 rounded-full ${getStatusColor(idea.status)}">${idea.status}</span>
              </div>
              
              ${idea.content ? `<p class="mt-3 text-gray-600">${idea.content}</p>` : ''}
              
              <div class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm">
                ${idea.category ? `<span class="text-gray-500">Category: <span class="text-gray-700">${idea.category}</span></span>` : ''}
                ${idea.source ? `<span class="text-gray-500">Source: <span class="text-gray-700">${idea.source}</span></span>` : ''}
              </div>

              <div class="mt-4 flex gap-4 text-sm">
                ${idea.code_url ? `<a href="${idea.code_url}" target="_blank" class="text-blue-600 hover:underline">View Code →</a>` : ''}
                ${idea.source_url ? `<a href="${idea.source_url}" target="_blank" class="text-blue-600 hover:underline">Source Material →</a>` : ''}
              </div>
            </div>
          </div>
          <div class="mt-4 text-xs text-gray-400">
            Added ${new Date(idea.created_at).toLocaleDateString()}
          </div>
        </div>
      `).join('');
    }

    function getStatusColor(status) {
      switch (status) {
        case 'idea': return 'bg-blue-100 text-blue-700';
        case 'in-progress': return 'bg-amber-100 text-amber-700';
        case 'done': return 'bg-emerald-100 text-emerald-700';
        case 'archived': return 'bg-zinc-200 text-zinc-600';
        default: return 'bg-gray-100 text-gray-600';
      }
    }

    // Form submission
    document.getElementById('add-idea-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      
      const payload = Object.fromEntries(formData.entries());
      
      const res = await fetch('/api/ideas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        form.reset();
        loadIdeas();
      } else {
        alert('Failed to save idea');
      }
    });

    // Filters
    const searchInput = document.getElementById('search');
    const classificationFilter = document.getElementById('classification-filter');
    const statusFilter = document.getElementById('status-filter');

    const debouncedLoad = debounce(loadIdeas, 300);
    searchInput.addEventListener('input', debouncedLoad);
    classificationFilter.addEventListener('change', loadIdeas);
    statusFilter.addEventListener('change', loadIdeas);

    // Initial load
    loadIdeas();
  </script>
</Layout>