---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Idea Bank">
  <main class="max-w-6xl mx-auto p-8">
    <div class="flex justify-between items-end mb-8">
      <div>
        <h1 class="text-4xl font-bold tracking-tight">Idea Bank</h1>
        <p class="text-gray-600 mt-1">Classify, link, and evolve your ideas.</p>
      </div>
      <div class="text-sm text-gray-500 font-mono">D1 + Astro</div>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap gap-3 mb-8">
      <input type="text" id="search" placeholder="Search ideas..." class="flex-1 min-w-[220px] border rounded-xl px-4 py-2.5 text-sm" />
      
      <select id="classification-filter" class="border rounded-xl px-4 py-2.5 text-sm min-w-[160px]">
        <option value="">All Classifications</option>
        <option value="Business">Business</option>
        <option value="AI">AI</option>
        <option value="Personal">Personal</option>
        <option value="Product">Product</option>
        <option value="Design">Design</option>
        <option value="Research">Research</option>
        <option value="Marketing">Marketing</option>
        <option value="Technical">Technical</option>
        <option value="Other">Other</option>
      </select>

      <select id="status-filter" class="border rounded-xl px-4 py-2.5 text-sm min-w-[150px]">
        <option value="">All Statuses</option>
        <option value="new">New</option>
        <option value="raw">Raw</option>
        <option value="in-progress">In Progress</option>
        <option value="review">Review</option>
        <option value="complete">Complete</option>
        <option value="discarded">Discarded</option>
        <option value="archived">Archived</option>
      </select>
    </div>

    <!-- Bulk Actions Bar -->
    <div id="bulk-bar" class="hidden mb-4 bg-zinc-900 text-white px-5 py-3 rounded-2xl flex items-center justify-between">
      <div class="flex items-center gap-4">
        <span id="selected-count" class="font-mono text-sm"></span>
        <button id="bulk-status-btn" class="text-sm px-4 py-1 bg-white/10 hover:bg-white/20 rounded-xl">Change Status</button>
        <button id="bulk-obsidian-btn" class="text-sm px-4 py-1 bg-white/10 hover:bg-white/20 rounded-xl">Export to Obsidian</button>
        <button id="bulk-export-csv-btn" class="text-sm px-4 py-1 bg-white/10 hover:bg-white/20 rounded-xl">Export CSV</button>
      </div>
      <button id="bulk-clear" class="text-sm text-white/60 hover:text-white">Clear selection</button>
    </div>

    <!-- Add Idea Form -->
    <div class="bg-white rounded-3xl shadow-sm border p-8 mb-12">
      <h2 class="text-2xl font-semibold mb-6">New Idea</h2>
      <form id="add-idea-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium mb-1.5">Title *</label>
            <input type="text" name="title" required class="w-full border rounded-2xl px-5 py-3 text-lg" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5">Classification</label>
            <select name="classification" class="w-full border rounded-2xl px-5 py-3">
              <option value="">Select classification</option>
              <option value="Business">Business</option>
              <option value="AI">AI</option>
              <option value="Personal">Personal</option>
              <option value="Product">Product</option>
              <option value="Design">Design</option>
              <option value="Research">Research</option>
              <option value="Marketing">Marketing</option>
              <option value="Technical">Technical</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1.5">Description</label>
          <textarea name="content" rows="4" class="w-full border rounded-2xl px-5 py-4"></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
          <div>
            <label class="block text-sm font-medium mb-1.5">Category</label>
            <input type="text" name="category" class="w-full border rounded-2xl px-5 py-3" placeholder="branding, infra..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5">Status</label>
            <select name="status" class="w-full border rounded-2xl px-5 py-3">
              <option value="new">New</option>
              <option value="raw">Raw</option>
              <option value="in-progress">In Progress</option>
              <option value="review">Review</option>
              <option value="complete">Complete</option>
              <option value="discarded">Discarded</option>
              <option value="archived">Archived</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5">Tags (comma separated)</label>
            <input type="text" name="tags" class="w-full border rounded-2xl px-5 py-3" placeholder="urgent, q2, client" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5">Source</label>
            <input type="text" name="source" class="w-full border rounded-2xl px-5 py-3" placeholder="Obsidian, meeting..." />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium mb-1.5">Code Repository / Link</label>
            <input type="url" name="code_url" class="w-full border rounded-2xl px-5 py-3" placeholder="https://github.com/..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5">Source Material / Data / Files</label>
            <input type="url" name="source_url" class="w-full border rounded-2xl px-5 py-3" placeholder="https://..." />
          </div>
        </div>

        <button type="submit" class="mt-4 bg-black hover:bg-zinc-900 transition text-white px-10 py-3.5 rounded-2xl font-medium">
          Save Idea
        </button>
      </form>
    </div>

    <!-- Ideas List -->
    <div>
      <div class="flex items-center justify-between mb-4 px-1">
        <h2 class="text-2xl font-semibold">All Ideas</h2>
        <div class="flex items-center gap-4">
          <div id="results-count" class="text-sm text-gray-500 font-mono"></div>
          <button id="export-csv" class="text-sm px-4 py-1.5 border rounded-xl hover:bg-gray-50">Export CSV</button>
        </div>
      </div>
      <div id="ideas-list" class="space-y-4"></div>
    </div>
  </main>

  <script>
    let selectedIds = new Set();
    let allIdeas = [];
    let debounceTimer;

    function debounce(fn, delay = 280) {
      return (...args) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => fn(...args), delay);
      };
    }

    async function loadIdeas() {
      const search = document.getElementById('search').value;
      const classification = document.getElementById('classification-filter').value;
      const status = document.getElementById('status-filter').value;

      const params = new URLSearchParams();
      if (search) params.set('search', search);
      if (classification) params.set('classification', classification);
      if (status) params.set('status', status);

      const res = await fetch(`/api/ideas?${params}`);
      const data = await res.json();
      allIdeas = data.ideas || [];
      renderIdeas(allIdeas);
      updateBulkBar();
    }

    function toggleSelect(id, checked) {
      if (checked) {
        selectedIds.add(id);
      } else {
        selectedIds.delete(id);
      }
      updateBulkBar();
    }

    function updateBulkBar() {
      const bar = document.getElementById('bulk-bar');
      const countEl = document.getElementById('selected-count');
      
      if (selectedIds.size > 0) {
        bar.classList.remove('hidden');
        bar.classList.add('flex');
        countEl.textContent = `${selectedIds.size} selected`;
      } else {
        bar.classList.add('hidden');
        bar.classList.remove('flex');
      }
    }

    function clearSelection() {
      selectedIds.clear();
      document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
      updateBulkBar();
    }

    function renderIdeas(ideas) {
      const container = document.getElementById('ideas-list');
      const countEl = document.getElementById('results-count');
      countEl.textContent = `${ideas.length} idea${ideas.length !== 1 ? 's' : ''}`;

      if (!ideas.length) {
        container.innerHTML = `<p class="text-gray-500 py-12 text-center">No ideas match your filters.</p>`;
        return;
      }

      container.innerHTML = ideas.map(idea => {
        let tagsHtml = '';
        if (idea.tags) {
          try {
            const tags = JSON.parse(idea.tags);
            if (Array.isArray(tags) && tags.length) {
              tagsHtml = tags.map(t => `<span class="px-3 py-0.5 text-xs bg-zinc-100 rounded-full">${t}</span>`).join('');
            }
          } catch {}
        }

        const isSelected = selectedIds.has(idea.id);

        return `
          <div class="bg-white border rounded-3xl p-7 hover:shadow-sm transition-all flex gap-5">
            <div class="pt-1">
              <input type="checkbox" 
                     class="w-4 h-4 accent-black" 
                     ${isSelected ? 'checked' : ''}
                     onchange="toggleSelect('${idea.id}', this.checked)" />
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-3 flex-wrap">
                <h3 class="font-semibold text-[21px] tracking-[-0.2px]">${idea.title}</h3>
                ${idea.classification ? `<span class="text-xs px-3.5 py-px rounded-full bg-zinc-900 text-white">${idea.classification}</span>` : ''}
                <span class="text-xs px-3.5 py-px rounded-full ${getStatusColor(idea.status)}">${formatStatus(idea.status)}</span>
              </div>

              ${idea.content ? `<p class="mt-4 text-[15px] text-gray-600 leading-relaxed">${idea.content}</p>` : ''}

              <div class="mt-5 flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-500">
                ${idea.category ? `<div>Category: <span class="text-gray-700">${idea.category}</span></div>` : ''}
                ${idea.source ? `<div>Source: <span class="text-gray-700">${idea.source}</span></div>` : ''}
              </div>

              ${tagsHtml ? `<div class="mt-4 flex flex-wrap gap-2">${tagsHtml}</div>` : ''}

              <div class="mt-5 flex gap-x-6 text-sm">
                ${idea.code_url ? `<a href="${idea.code_url}" target="_blank" class="text-blue-600 hover:underline flex items-center gap-1">Code →</a>` : ''}
                ${idea.source_url ? `<a href="${idea.source_url}" target="_blank" class="text-blue-600 hover:underline flex items-center gap-1">Source →</a>` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function getStatusColor(status) {
      const colors = {
        'new': 'bg-emerald-100 text-emerald-700',
        'raw': 'bg-amber-100 text-amber-700',
        'in-progress': 'bg-blue-100 text-blue-700',
        'review': 'bg-purple-100 text-purple-700',
        'complete': 'bg-green-100 text-green-700',
        'discarded': 'bg-red-100 text-red-700',
        'archived': 'bg-zinc-200 text-zinc-600'
      };
      return colors[status] || 'bg-gray-100 text-gray-600';
    }

    function formatStatus(status) {
      const map = {
        'new': 'New',
        'raw': 'Raw',
        'in-progress': 'In Progress',
        'review': 'Review',
        'complete': 'Complete',
        'discarded': 'Discarded',
        'archived': 'Archived'
      };
      return map[status] || status;
    }

    // Bulk actions
    document.getElementById('bulk-clear').addEventListener('click', clearSelection);

    document.getElementById('bulk-status-btn').addEventListener('click', async () => {
      const newStatus = prompt('Enter new status (new, raw, in-progress, review, complete, discarded, archived):');
      if (!newStatus) return;

      const res = await fetch('/api/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'update-status',
          ids: Array.from(selectedIds),
          newStatus
        })
      });

      if (res.ok) {
        selectedIds.clear();
        loadIdeas();
      }
    });

    document.getElementById('bulk-obsidian-btn').addEventListener('click', async () => {
      const res = await fetch('/api/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'export-obsidian',
          ids: Array.from(selectedIds)
        })
      });

      const data = await res.json();
      if (data.files) {
        // Download each file
        data.files.forEach(file => {
          const blob = new Blob([file.content], { type: 'text/markdown' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = file.filename;
          a.click();
        });
        alert(`Downloaded ${data.files.length} markdown file(s) for Obsidian. Drop them into your vault.`);
      }
    });

    document.getElementById('bulk-export-csv-btn').addEventListener('click', () => {
      const selectedIdeas = allIdeas.filter(i => selectedIds.has(i.id));
      exportToCSV(selectedIdeas);
    });

    // Single export
    document.getElementById('export-csv').addEventListener('click', () => {
      exportToCSV(allIdeas);
    });

    function exportToCSV(ideas) {
      if (!ideas.length) return alert('No ideas to export');

      const headers = ['title', 'classification', 'status', 'category', 'tags', 'content', 'code_url', 'source_url', 'created_at'];
      const rows = ideas.map(idea => {
        let tags = '';
        try { tags = idea.tags ? JSON.parse(idea.tags).join('; ') : ''; } catch {}
        return [
          `"${idea.title}"`,
          idea.classification || '',
          idea.status,
          idea.category || '',
          tags,
          `"${(idea.content || '').replace(/"/g, '""')}"`,
          idea.code_url || '',
          idea.source_url || '',
          idea.created_at
        ].join(',');
      });

      const csv = [headers.join(','), ...rows].join('\n');
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'ideas.csv';
      a.click();
    }

    // Form submission
    document.getElementById('add-idea-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      
      const tagsRaw = formData.get('tags');
      let tags = null;
      if (tagsRaw) {
        tags = tagsRaw.split(',').map(t => t.trim()).filter(Boolean);
      }

      const payload = {
        title: formData.get('title'),
        content: formData.get('content'),
        category: formData.get('category'),
        classification: formData.get('classification'),
        status: formData.get('status'),
        source: formData.get('source'),
        code_url: formData.get('code_url'),
        source_url: formData.get('source_url'),
        tags: tags ? JSON.stringify(tags) : null
      };

      const res = await fetch('/api/ideas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        form.reset();
        loadIdeas();
      } else {
        alert('Failed to save idea');
      }
    });

    // Filters
    const searchInput = document.getElementById('search');
    const classificationFilter = document.getElementById('classification-filter');
    const statusFilter = document.getElementById('status-filter');

    const debouncedLoad = debounce(loadIdeas, 280);
    searchInput.addEventListener('input', debouncedLoad);
    classificationFilter.addEventListener('change', loadIdeas);
    statusFilter.addEventListener('change', loadIdeas);

    // Expose toggleSelect to inline handlers
    window.toggleSelect = toggleSelect;

    loadIdeas();
  </script>
</Layout>